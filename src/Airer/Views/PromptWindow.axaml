<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Airer.Views.PromptWindow"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Topmost="True"
        ShowInTaskbar="False">
  <StackPanel Margin="24" Spacing="14">
    <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock x:Name="BodyText" FontSize="13" TextWrapping="Wrap" Opacity="0.85" LineHeight="20" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="Secondary" MinWidth="92" />
      <Button x:Name="Primary" MinWidth="92" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
