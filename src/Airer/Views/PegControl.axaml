<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Airer.Views.PegControl"
             RenderTransformOrigin="50%,0%">
  <StackPanel Spacing="-12" HorizontalAlignment="Center" VerticalAlignment="Top">
    <Panel Width="9" Height="26" HorizontalAlignment="Center" IsHitTestVisible="False">
      <Border CornerRadius="3.5" BorderThickness="0.6" BorderBrush="#66000000">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
            <GradientStop Offset="0" Color="#B4B4B4" />
            <GradientStop Offset="0.35" Color="#F4F4F4" />
            <GradientStop Offset="0.65" Color="#D2D2D2" />
            <GradientStop Offset="1" Color="#8E8E8E" />
          </LinearGradientBrush>
        </Border.Background>
        <Border Width="5" Height="1.5" Background="#66000000" CornerRadius="1"
                Margin="0,8,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" />
      </Border>
    </Panel>
    <Border x:Name="Card" CornerRadius="16" Padding="4" Background="#D0FFFFFF"
            BorderBrush="#A0FFFFFF" BorderThickness="1" BoxShadow="0 8 16 0 #40000000"
            HorizontalAlignment="Center">
      <Panel>
        <Border x:Name="PhotoFrame" CornerRadius="12" ClipToBounds="True">
          <Image x:Name="Photo" Stretch="Fill" />
        </Border>
        <Border x:Name="Close" Width="20" Height="20" CornerRadius="10"
                Background="#E6F4F4F4" BorderBrush="#99FFFFFF" BorderThickness="0.8"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2" IsVisible="False">
          <TextBlock Text="×" FontSize="13" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#222222" />
        </Border>
        <Border x:Name="Copied" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Background="#F2FFFFFF" CornerRadius="12" Padding="8,4" Margin="0,0,0,-16"
                BoxShadow="0 2 8 0 #33000000" IsVisible="False" IsHitTestVisible="False">
          <TextBlock x:Name="CopiedText" FontSize="11" FontWeight="SemiBold" Foreground="#222222" />
        </Border>
      </Panel>
    </Border>
  </StackPanel>
</UserControl>
