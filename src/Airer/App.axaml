<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Airer.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter, PingFang SC, Microsoft YaHei UI, Segoe UI, sans-serif" />
    </Style>
  </Application.Styles>
</Application>
